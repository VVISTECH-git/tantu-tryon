# Copy to apps/web/.env.local for local development. Production values live in
# the Vercel project's environment settings. Never commit .env.local.

# ── Database (Neon Postgres in production; embedded Postgres locally) ─────────
# Local: run `pnpm dev:db` and paste the URL it prints.
DATABASE_URL=postgresql://postgres:devpass@localhost:5434/tantu
# Direct (non-pooler) connection for migrations. Neon's Vercel integration sets
# DATABASE_URL_UNPOOLED; locally the two are the same.
DATABASE_URL_UNPOOLED=postgresql://postgres:devpass@localhost:5434/tantu
# "dev" locally. Anything else makes a local process warn that it may be
# talking to production.
APP_DB_ENV=dev

# ── Sign-in (version one: one shared passcode) ────────────────────────────────
STUDIO_PASSCODE=

# ── Image engine ──────────────────────────────────────────────────────────────
# Gemini key on a Google Cloud project WITH BILLING ENABLED (the image models
# have no free tier). Also set a budget alert and a requests/day quota on that
# project; Google never hard-stops on budget.
GEMINI_API_KEY=
# Optional overrides of the model ids in packages/engine/src/providers/gemini.ts
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# GEMINI_IMAGE_MODEL_HIGH=gemini-3-pro-image

# ── Spend brakes ──────────────────────────────────────────────────────────────
# Set to "true" to refuse every generation without a deploy of anything else.
GENERATION_DISABLED=false
# Hard caps on what we pay Google, in rupees, Asia/Kolkata days and months.
# The settings table can override these at runtime from /admin/spend.
SPEND_CAP_DAILY_INR=500
SPEND_CAP_MONTHLY_INR=5000
# Rupees per US dollar used to turn Google's list prices into paise.
USD_INR=88

# ── Storage (Cloudflare R2) ───────────────────────────────────────────────────
# The bucket needs a CORS rule allowing PUT with Content-Type from the app's
# origins (including http://localhost:3000 for development).
R2_ACCOUNT_ID=
R2_BUCKET=tantu-tryon
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
# Without R2, uploads and renders are written here (local development only).
# Set it to the app's own public/ folder; `next dev` may be started elsewhere.
TANTU_LOCAL_DIR=

# ── SLK inventory (product lookup by code) ────────────────────────────────────
SLK_API_BASE=
SLK_READ_SECRET=

# ── Reading the garment into words (any one of these enables the button) ─────
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# The Gemini key above also works for describing.
